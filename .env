# Floci local AWS settings. Load with: set -a; . ./.env; set +a

# Send every AWS SDK, CLI and Terraform call to Floci instead of AWS.
AWS_ENDPOINT_URL=http://localhost:4566

# AWS SDKs and Terraform address buckets as <bucket>.<endpoint host>. <bucket>.localhost doesn't
# resolve on macOS, while every *.localhost.floci.io name resolves to 127.0.0.1.
AWS_ENDPOINT_URL_S3=http://s3.localhost.floci.io:4566

# Terraform's AWS provider reads bucket tags through S3 Control, which puts the account ID in front
# of the host (000000000000.<endpoint host>). The Floci name resolves that too.
AWS_ENDPOINT_URL_S3_CONTROL=http://s3-control.localhost.floci.io:4566

# Floci accepts any non-empty keys. Static keys win over your shell's AWS_PROFILE in boto3 and
# Terraform, so local runs never sign with real credentials. AWS_PROFILE may stay set, but it must
# name a profile that exists: both tools fail on an empty or unknown profile name.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# boto3 reads AWS_DEFAULT_REGION and Terraform reads AWS_REGION, so set both.
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
