# Floci local AWS settings. Load with: set -a; . ./.env; set +a

# Send every AWS SDK, CLI and CDK call to Floci instead of AWS.
AWS_ENDPOINT_URL=http://localhost:4566

# The CDK CLI uploads assets to <bucket>.<endpoint host>. <bucket>.localhost doesn't resolve on macOS,
# while every *.localhost.floci.io name resolves to 127.0.0.1.
AWS_ENDPOINT_URL_S3=http://s3.localhost.floci.io:4566

# Floci accepts any non-empty keys. These static keys also win over your shell's AWS_PROFILE in
# boto3 and the CDK CLI, so local runs never sign with real credentials. Don't blank AWS_PROFILE:
# boto3 fails on an empty or unknown profile name.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# boto3 reads AWS_DEFAULT_REGION and the CDK CLI reads AWS_REGION, so set both.
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# Skip the CDK CLI's npm version check, a network call on every command.
CDK_DISABLE_VERSION_CHECK=1
